[sub_resource type="Shader" id="Shader_crt_vignette"]
code = "shader_type canvas_item;

uniform vec4 bg_color_center : source_color = vec4(0.055, 0.051, 0.078, 1.0);
uniform vec4 bg_color_edge : source_color = vec4(0.020, 0.024, 0.031, 1.0);
uniform float vignette_power : hint_range(0.5, 4.0) = 1.8;
uniform float scanline_intensity : hint_range(0.0, 0.5) = 0.06;

void fragment() {
	vec2 uv = UV;
	vec2 center = uv - vec2(0.5);
	float dist = length(center * vec2(1.25, 1.0));
	float vig = clamp(pow(dist, vignette_power), 0.0, 1.0);
	vec4 col = mix(bg_color_center, bg_color_edge, vig);
	
	// Hardware scanline: alternates on physical screen raster lines without sine blur
	float scanline = mod(floor(FRAGCOORD.y), 2.0) * scanline_intensity;
	col.rgb -= scanline;
	
	COLOR = col;
}
"

